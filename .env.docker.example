PORT=5173
DATABASE_URL=file:/app/data/hcdrive.db

# Khi dung Cloudflare: https://drive.example.com
FRONTEND_URL=http://localhost:5173

JWT_ACCESS_SECRET=change-this-jwt-secret-at-least-32-chars
TOKEN_ENCRYPTION_KEY=change-this-encryption-key-32bytes!
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/connected-accounts/google/callback
RECAPTCHA_SECRET_KEY=
ADMIN_EMAILS=nhmt@hetcuu.com

# Client IP for rate limits and the session list. Leave empty when the backend is reached directly
# (http://host:5173). Behind a reverse proxy set e.g. TRUST_PROXY=loopback or 172.16.0.0/12;
# behind Cloudflare only (no other way in) set TRUST_PROXY=cloudflare.
TRUST_PROXY=
# API requests allowed per signed-in user (or per IP before sign-in) in each window.
RATE_LIMIT_MAX=2000
RATE_LIMIT_WINDOW_MINUTES=15
INITIAL_USER_NAME=nhmt
INITIAL_USER_EMAIL=nhmt@hetcuu.com
INITIAL_USER_PASSWORD=admin
