PORT=5173
DATABASE_URL=file:/app/data/hcdrive.db

# Khi dung Cloudflare: https://drive.example.com
FRONTEND_URL=http://localhost:5173

JWT_ACCESS_SECRET=change-this-jwt-secret-at-least-32-chars
TOKEN_ENCRYPTION_KEY=change-this-encryption-key-32bytes!
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/connected-accounts/google/callback
# Captcha (Google reCAPTCHA or Cloudflare Turnstile) is set in Settings → Security. These older
# variables still work when nothing is saved there. DISABLE_CAPTCHA=true turns every check off
# (use it if a wrong key locks you out of signing in).
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
DISABLE_CAPTCHA=
ADMIN_EMAILS=nhmt@hetcuu.com

# Client IP for rate limits and the session list. Leave empty: HCDrive detects Cloudflare and
# reverse proxies on private addresses (nginx, Docker) itself (Settings → Security shows what it saw).
# Set it only to override: false (trust no proxy), cloudflare, loopback, 172.16.0.0/12, ...
TRUST_PROXY=
# API requests allowed per signed-in user (or per IP before sign-in) in each window.
RATE_LIMIT_MAX=2000
RATE_LIMIT_WINDOW_MINUTES=15
INITIAL_USER_NAME=nhmt
INITIAL_USER_EMAIL=nhmt@hetcuu.com
INITIAL_USER_PASSWORD=admin
